# Environment variables for TaskStore
# Copy this file to .env and fill in your values

# ── Server ────────────────────────────────────────
PORT=3000
NODE_ENV=development   # 'development' or 'production'

# ── Session ───────────────────────────────────────
# Use a long, random, unguessable string in production
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# ── Database ──────────────────────────────────────
# SQLite fallback path (used when DATABASE_URL is not set or unreachable)
DB_PATH=./database.sqlite

# PostgreSQL connection string (optional)
# When set: app connects to Postgres first.
# If the connection fails or this var is absent: app falls back to SQLite.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
